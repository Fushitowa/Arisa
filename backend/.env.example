GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3
DATABASE_PATH=./lizz.db
MAX_UPLOAD_MB=10

# ── Voice / TTS settings ─────────────────────────────────────────────────────
# Provider: "edge" (free, no key needed) or "elevenlabs" (premium)
TTS_PROVIDER=edge
# edge-tts voice — see https://aka.ms/edge-tts-voices for the full list
EDGE_TTS_VOICE=en-US-JennyNeural
EDGE_TTS_RATE=-5%
EDGE_TTS_PITCH=+2Hz
# ElevenLabs — only used when TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Default voice ID is Rachel; swap for any voice from your ElevenLabs library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
